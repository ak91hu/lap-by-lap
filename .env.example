# Copy to .env and fill in. / Másold .env néven, és töltsd ki.
# Create your keys at https://www.strava.com/settings/api (Authorization Callback Domain: localhost)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Optional / Opcionális ---------------------------------------------------
PORT=3000
# BASE_URL=http://localhost:3000
# DATA_DIR=data
# SESSION_SECRET=            # generated and stored in DATA_DIR if empty

# Language detection by IP country (HU → Hungarian, otherwise English).
# GEOIP=off                  # disable the lookup (falls back to the browser language)
# GEOIP_URL=https://api.country.is/
# DEFAULT_LANG=en
# TRUST_PROXY=loopback       # set when running behind a reverse proxy

# Optional basemap tiles for route maps (respect the provider's terms!).
# Without it, routes are drawn as clean vector maps.
# Example (CARTO Positron, free for non-commercial use with attribution):
# MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© OpenStreetMap contributors © CARTO
